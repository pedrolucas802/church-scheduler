# --------------------------------------------------
# Application database (church scheduler)
# --------------------------------------------------
POSTGRES_PASSWORD=change-me-now
DATABASE_URL=postgresql+psycopg2://church_admin:change-me-now@db_local:5432/church_scheduler


# --------------------------------------------------
# Keycloak database
# --------------------------------------------------
KC_DB_PASSWORD=change-me-now


# --------------------------------------------------
# Keycloak admin account
# --------------------------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-now


# --------------------------------------------------
# Keycloak URLs
# --------------------------------------------------

# Container -> Keycloak (internal Docker network)
KC_BASE_URL=http://keycloak_local:8080

# Browser -> Keycloak (public address)
KC_PUBLIC_BASE_URL=http://localhost:8081

# Realm
KC_REALM=churchschedule


# --------------------------------------------------
# OAuth / OIDC client
# --------------------------------------------------
KC_CLIENT_ID=church-scheduler
KC_CLIENT_SECRET=change-me-client-secret

# Where Keycloak redirects back to Streamlit
KC_REDIRECT_URI=http://localhost:8501


# --------------------------------------------------
# Streamlit application
# --------------------------------------------------
APP_BASE_URL=http://localhost:8501


# --------------------------------------------------
# Cookie encryption (important for login state)
# --------------------------------------------------
COOKIE_SECRET=change-this-to-a-long-random-string


# --------------------------------------------------
# Keycloak roles that count as admin
# (comma separated)
# --------------------------------------------------
KC_ADMIN_ROLES=super_admin,ministry_admin

DEFAULT_MINISTRY_ID=1
